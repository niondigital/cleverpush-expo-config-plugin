{
  "name": "@niondigital/cleverpush-expo-config-plugin",
  "version": "3.0.0",
  "description": "Expo config plugin to add CleverPush extensions on prebuild",
  "main": "build/withCleverPush.js",
  "types": "build/withCleverPush.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "test": "expo-module test",
    "prepare": "expo-module clean && expo-module build",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "expo": ">=56",
    "expo-build-properties": ">=0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.1",
    "expo": "^58.0.0",
    "expo-build-properties": "^58.0.0",
    "expo-module-scripts": "^56.0.3",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "expo",
    "cleverpush",
    "push",
    "notifications",
    "EAS"
  ],
  "author": "nion digital GmbH",
  "license": "MIT",
  "homepage": "https://www.nion-digital.com",
  "bugs": {
    "url": "https://github.com/niondigital/cleverpush-expo-config-plugin/issues"
  }
}
